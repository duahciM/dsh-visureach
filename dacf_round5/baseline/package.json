{
  "name": "@local/dsh-video-observer",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Video observation tools: keyframe catalogue, change hints, native-resolution frame delivery and source-video resampling for an image-capable Agent.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "integration.js",
    "journal.js",
    "proof.js",
    "process_lock.js",
    "observation_tools.js",
    "navigation_links.js",
    "guide.js",
    "live_plugin.js",
    "viewer.js",
    "mcp_stdio.js",
    "stream_contract.schema.json",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "docs",
    "icon.svg",
    "python/**/*",
    "vendor/**/*"
  ],  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
