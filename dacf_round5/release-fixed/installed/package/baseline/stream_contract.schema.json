{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video observer proposed live stream receipt v1",
  "type": "object",
  "required": ["protocol", "stream_id", "epoch", "sequence", "event", "committed_through_pts", "time_base"],
  "additionalProperties": false,
  "properties": {
    "protocol": {"const": "video-observer-stream/v1"},
    "stream_id": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 0},
    "sequence": {"type": "integer", "minimum": 0},
    "event": {"enum": ["opened", "frame_committed", "gap", "backpressure", "discontinuity", "draining", "closed", "failed"]},
    "committed_through_pts": {"type": ["integer", "null"]},
    "time_base": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"},
    "pts": {"type": "integer"},
    "original_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "range_pts": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "frame_committed"}}}, "then": {"required": ["pts", "original_sha256"]}},
    {"if": {"properties": {"event": {"const": "gap"}}}, "then": {"required": ["range_pts", "reason"]}},
    {"if": {"properties": {"event": {"enum": ["backpressure", "discontinuity", "failed"]}}}, "then": {"required": ["reason"]}}
  ]
}
